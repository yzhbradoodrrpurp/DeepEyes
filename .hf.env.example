# Hugging Face template for DeepEyes.
# Copy to DeepEyes/.hf.env on the trusted remote server and fill real values.
# Do not commit DeepEyes/.hf.env.

export HF_TOKEN=
export HF_ENDPOINT=
export HF_HOME=/home/deeplearn/dataDisk/hf_cache
export HUGGINGFACE_HUB_CACHE=/home/deeplearn/dataDisk/hf_cache/hub
export HF_HUB_OFFLINE=
export TRANSFORMERS_OFFLINE=
export HF_HUB_DISABLE_XET=1
