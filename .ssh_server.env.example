# Local-only SSH and remote workspace template.
# Copy to .ssh_server.env and fill real values locally. Do not commit real values.

SSH_REMOTE_USER=root
SSH_REMOTE_HOST=connect.westd.seetacloud.com
SSH_REMOTE_PORT=16294
SSH_REMOTE_CODE_DIR=/root/autodl-tmp/deepeyes

# Optional remote paths used by scripts.
SSH_REMOTE_RESULTS_DIR=/root/autodl-tmp/deepeyes/results
SSH_REMOTE_DATA_DIR=/root/data
SSH_REMOTE_TEMP_DELETE=/root/data/temp_delete

# Optional whitespace-separated SSH options.
SSH_REMOTE_SSH_OPTIONS="-o StrictHostKeyChecking=accept-new"

# Optional. Prefer interactive auth or key-based auth when available.
# SSH_REMOTE_PASSWORD=
