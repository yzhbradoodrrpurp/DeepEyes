# MiMo/OpenAI-compatible judge template for DeepEyes.
# Copy to DeepEyes/.mimo.env on the trusted remote server and fill real values.
# Do not commit DeepEyes/.mimo.env.

export MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
export MIMO_API_KEY=
export MIMO_MODEL=mimo-v2.5

export LLM_AS_A_JUDGE_BASE="${MIMO_BASE_URL}"
export LLM_AS_A_JUDGE_API_KEY="${MIMO_API_KEY}"
export LLM_AS_A_JUDGE_MODEL="${MIMO_MODEL}"
