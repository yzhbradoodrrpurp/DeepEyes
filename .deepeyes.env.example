# DeepEyes runtime template.
# Copy to DeepEyes/.deepeyes.env on the trusted remote server and fill local values.
# Do not commit DeepEyes/.deepeyes.env.

export DEEPEYES_CONDA_INIT='source /opt/conda/etc/profile.d/conda.sh'
export DEEPEYES_CONDA_ENV=verl
export DEEPEYES_CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

export DEEPEYES_MODEL=/home/deeplearn/dataDisk/qwen3-vl-8b
export DEEPEYES_SOURCE_TRAIN_FILE=/home/deeplearn/dataDisk/zwz_dataset/reannotate_verl_format_teacher_crop_train23k/train.parquet
export DEEPEYES_SAVE_CHECKPOINT_DIR=/home/deeplearn/dataDisk/deepeyes_original_step_timing
export DEEPEYES_TOTAL_TRAINING_STEPS=10

# Set to 1 when the source parquet changed and the DeepEyes-adapted parquet
# should be rebuilt.
export DEEPEYES_REBUILD_DATA=0

# Optional Hugging Face endpoint override.
export DEEPEYES_HF_ENDPOINT=
